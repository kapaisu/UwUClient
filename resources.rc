#include <windows.h>
#include <winver.h>

#define RT_MANIFEST_ID 1
RT_MANIFEST_ID RT_MANIFEST "resources.manifest"

#define VER_FILE 2,0,0,0
#define VER_PROD 2,0,0,0
#define VER_FILE_STR "2.0.0.0"
#define VER_PROD_STR "2.0.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILE
 PRODUCTVERSION VER_PROD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "q3c Software"
            VALUE "FileDescription",  "uwuclient - game overlay utility"
            VALUE "FileVersion",      VER_FILE_STR
            VALUE "InternalName",     "UwUClient"
            VALUE "LegalCopyright",   "Copyright (C) 2026 q3c"
            VALUE "OriginalFilename", "UwUClient.exe"
            VALUE "ProductName",      "uwuclient"
            VALUE "ProductVersion",   VER_PROD_STR
            VALUE "Comments",         "In-game overlay utility."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
